POSTGRES_USER=enterprise
POSTGRES_PASSWORD=changeme
POSTGRES_DB=enterprise

TZ=Europe/Moscow

N8N_DISPATCH_WEBHOOK_URL=https://n8n.example.test/webhook/automation-dispatch
N8N_HEALTHCHECK_URL=https://n8n.example.test/healthz
N8N_SERVICE_TOKEN=replace-with-service-token
N8N_TIMEOUT_SECONDS=10
PRINT_SERVICE_TOKEN=replace-with-service-token
SUPPLY_PRINT_PRINTER_NAME=HP LaserJet Pro MFP M125rnw

# n8n runtime references used by the supply.print_job transport branch.
EOS_API_BASE_URL=http://api:8000
PRINT_AGENT_URL=http://windows-print-agent-host:8765

# iikoServer REST API is disabled by default.
IIKO_ENABLED=false
IIKO_BASE_URL=https://iiko.example.test/resto
IIKO_API_TYPE=iiko_server
IIKO_LOGIN=
IIKO_PASSWORD=
IIKO_REQUEST_TIMEOUT_SECONDS=45
IIKO_CONNECT_TIMEOUT_SECONDS=10
IIKO_VERIFY_TLS=true
IIKO_MAX_SAFE_RETRIES=1
IIKO_SYNC_PAGE_SIZE=500
